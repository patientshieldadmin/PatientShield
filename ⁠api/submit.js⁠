// api/submit.js - Automated Ingestion Webhook Handler
export default async function handler(req, res) {
    if (req.method !== 'POST') {
        return res.status(405).json({ error: 'Method not allowed' });
    }

    try {
        const { fullName, email, phone, caseType } = req.body;

        // Validation check
        if (!fullName || !email || !caseType) {
            return res.status(400).json({ error: 'Missing required fields' });
        }

        console.log(`New automated lead captured: ${fullName} (${caseType})`);

        return res.status(200).json({ 
            success: true, 
            message: 'Lead successfully processed by PatientShield automated engine.' 
        });

    } catch (error) {
        console.error('Ingestion error:', error);
        return res.status(500).json({ error: 'Internal server error during automated processing.' });
    }
}
