// api/submit.js - Automated Ingestion Webhook Handler
export default async function handler(req, res) {
    // Ensure CORS headers are present if needed
    res.setHeader('Access-Control-Allow-Credentials', true);
    res.setHeader('Access-Control-Allow-Origin', '*');
    res.setHeader('Access-Control-Allow-Methods', 'POST,OPTIONS');
    res.setHeader('Access-Control-Allow-Headers', 'Content-Type');

    if (req.method === 'OPTIONS') {
        return res.status(200).end();
    }

    if (req.method !== 'POST') {
        return res.status(405).json({ error: 'Method not allowed' });
    }

    try {
        // Robust body parsing for serverless environments
        let body = req.body;
        if (typeof body === 'string') {
            body = JSON.parse(body);
        }

        const fullName = body?.fullName;
        const email = body?.email;
        const phone = body?.phone;
        const caseType = body?.caseType;

        // Validation check
        if (!fullName || !email || !caseType) {
            return res.status(400).json({ error: 'Missing required fields: fullName, email, or caseType.' });
        }

        console.log(`New automated lead captured: ${fullName} (${caseType}) - Email: ${email}`);

        // Return a successful response
        return res.status(200).json({ 
            success: true, 
            message: 'Lead successfully processed by PatientShield automated engine.' 
        });

    } catch (error) {
        console.error('Ingestion error:', error);
        return res.status(500).json({ error: error.message || 'Internal server error during automated processing.' });
    }
}
